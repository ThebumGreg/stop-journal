RECORDER_URL=http://192.168.x.x:8083
RECORDER_USER=
RECORDER_DEVICE=
RECORDER_AUTH=
APP_TZ=America/Los_Angeles
# osm | osm_google (OSM first, Google only when OSM comes up short) | google
PLACES_PROVIDER=osm
GOOGLE_PLACES_KEY=
# Hard cap on Google requests per UTC day (0 = block Google entirely)
GOOGLE_DAILY_CAP=100
# In osm_google mode, ask Google only if OSM finds fewer business-like places than this
GOOGLE_FALLBACK_MIN=3
STOP_MIN_MINUTES=10
STOP_RADIUS_M=100
STOP_MAX_GAP_MIN=15
STOP_MERGE_GAP_MIN=60
MAX_ACC_M=100
PLACES_RADIUS_M=150
# Public Overpass instances get overloaded; point this at a mirror or your own if needed
OVERPASS_URL=https://overpass-api.de/api/interpreter
APP_PASSWORD=
DATA_DIR=/data

# --- Notifications (Pushover) and alerts ---
PUSHOVER_TOKEN=
PUSHOVER_USER=
# Tapping a notification opens this address, e.g. http://192.168.x.x:5000
APP_URL=
# Alert when no location point arrives for this long during work hours
ALERT_NO_DATA=on
ALERT_NO_DATA_MIN=60
WORK_DAYS=Mon-Fri
WORK_START=07:00
WORK_END=17:00
# 0 = alert once per outage; otherwise repeat the reminder this often
ALERT_REPEAT_MIN=0
BACKUP_KEEP=14

# Road distance for miles-to-home (public OSRM; blank = straight-line estimate)
ROUTING_URL=https://router.project-osrm.org

# Grammar check for work notes (self-hosted LanguageTool; blank = off). Example: http://192.168.1.10:8010
LANGUAGETOOL_URL=
