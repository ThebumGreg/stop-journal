RECORDER_URL=http://192.168.x.x:8083
RECORDER_USER=
RECORDER_DEVICE=
RECORDER_AUTH=
APP_TZ=America/Los_Angeles
# osm | osm_google (OSM first, Google only when OSM comes up short) | google
PLACES_PROVIDER=osm
GOOGLE_PLACES_KEY=
# Hard cap on Google requests per UTC day (0 = block Google entirely)
GOOGLE_DAILY_CAP=100
# In osm_google mode, ask Google only if OSM finds fewer business-like places than this
GOOGLE_FALLBACK_MIN=3
STOP_MIN_MINUTES=10
STOP_RADIUS_M=100
STOP_MAX_GAP_MIN=15
STOP_MERGE_GAP_MIN=60
MAX_ACC_M=100
PLACES_RADIUS_M=150
# Public Overpass instances get overloaded; point this at a mirror or your own if needed
OVERPASS_URL=https://overpass-api.de/api/interpreter
APP_PASSWORD=
DATA_DIR=/data
